# Normalize line endings: store LF in the repo, check out native on each OS.
* text=auto

# Explicit text types
*.html   text
*.css    text
*.js     text
*.json   text
*.md     text
*.svg    text
*.txt    text
*.xml    text
*.webmanifest text

# Binary — never touch line endings
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.avif   binary
*.ico    binary
*.mp4    binary
*.mov    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.pdf    binary
